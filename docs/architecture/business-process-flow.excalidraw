    {"id":"guardrail-text","type":"text","x":100,"y":1350,"width":2240,"height":80,"text":"Evidence is not entitlement. Independent findings are dated facts; contested or adverse outcomes require authorised human review and due process.\nAdvances may start 16 October; ordinary/balance payments normally from 1 December, normal deadline 30 June next year. Audit lineage is maintained throughout.","fontSize":16,"fontFamily":2,"strokeColor":"#000000","textAlign":"center","verticalAlign":"middle","containerId":"guardrail-box","lineHeight":1.25}
